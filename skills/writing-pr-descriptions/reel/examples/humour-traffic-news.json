          "say": "Reviewers: flag off, and resizes take the old road.",
          "sfx": [
            {
              "name": "click",
              "at": 0.1
            },
            {
              "name": "whoosh-short",
              "at": 0.2,
              "vol": 0.2
            }
          ]
